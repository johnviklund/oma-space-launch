#!/usr/bin/env python3
"""Explicitly enable repository-local agent instructions. Requires Python 3 stdlib."""

import argparse
import hashlib
import json
import os
import sys
import tempfile
from pathlib import Path


def digest(data):
    return hashlib.sha256(data).hexdigest()


def check_path(root, path):
    current = path
    while current != root:
        if current.is_symlink():
            raise ValueError(f"refusing symlinked destination: {current.relative_to(root)}")
        if current != path and current.exists() and not current.is_dir():
            raise ValueError(f"destination parent is not a directory: {current.relative_to(root)}")
        current = current.parent
    if path.exists() and not path.is_file():
        raise ValueError(f"destination is not a regular file: {path.relative_to(root)}")


def write_atomic(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(data)
            stream.flush()
            os.chmod(temporary, 0o644)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    root = Path(__file__).resolve().parent.parent
    source = root / "dev/agent-tools"
    destinations = {
        "AGENTS.md": "repo-instructions.md",
        ".agents/skills/verify-oma-space-launch/SKILL.md": "skill-entry.md",
        ".claude/skills/verify-oma-space-launch/SKILL.md": "skill-entry.md",
    }
    state_path = root / ".agent-tools-state.json"
    try:
        check_path(root, state_path)
        previous = json.loads(state_path.read_text()) if state_path.exists() else {}
        if not isinstance(previous, dict):
            raise ValueError("invalid .agent-tools-state.json; save it elsewhere before retrying")
        planned = {}
        hashes = {}
        # Preflight all destinations before writing any instruction file.
        for name, origin in destinations.items():
            target = root / name
            check_path(root, target)
            data = (source / origin).read_bytes()
            hashes[name] = digest(data)
            if target.exists():
                existing = target.read_bytes()
                if existing == data:
                    continue
                if digest(existing) != previous.get(name):
                    raise ValueError(f"refusing to overwrite {name}; save it elsewhere before retrying")
            planned[target] = data
        for target, data in planned.items():
            write_atomic(target, data)
        state = (json.dumps(hashes, indent=2) + "\n").encode()
        if not state_path.exists() or state_path.read_bytes() != state:
            write_atomic(state_path, state)
    except (OSError, ValueError) as error:
        print(f"agent setup failed: {error}", file=sys.stderr)
        return 1
    print(f"Agent tools enabled locally; {len(planned)} instruction files written. Restart your agent session.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
